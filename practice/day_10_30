# mymodule.py
def greet(name):
    return f"你好，{name}！"

print("这行会执行")      # ← 这句在导入时也会跑！

#当你在 main.py 里 import mymodule 时，mymodule.py 会被完整执行一遍，print("这行会执行") 也会打印——这通常不是我们想要的。

#解决办法：把"执行代码"放进这个块里
# mymodule.py
def greet(name):
    return f"你好，{name}！"

if __name__ == "__main__":
    # ⬇ 只有"直接运行这个文件"时才执行
    # ⬇ 被别人 import 时，这里面的代码不执行
    print(greet("测试"))


